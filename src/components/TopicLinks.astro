---
import { siteConfig } from '../config/site';

const baseUrl = siteConfig.baseUrl;
const links = [
  {
    href: `${baseUrl}/en/crab-prices/`,
    title: 'Crab prices',
    desc: 'How crab is weighed and priced, and a way to budget.',
  },
  {
    href: `${baseUrl}/en/how-to-buy-crab/`,
    title: 'How to buy crab',
    desc: 'Pick live crab, check the scale, agree the cooking price.',
  },
  {
    href: `${baseUrl}/en/how-to-get-there/`,
    title: 'How to get there',
    desc: 'Directions from Kampot and Phnom Penh to the market.',
  },
  {
    href: `${baseUrl}/en/kep-day-trip-from-kampot/`,
    title: 'Kampot day trip',
    desc: 'A relaxed itinerary built around lunch at the market.',
  },
];
---

<section class="mx-auto my-10 max-w-5xl px-4">
  <h2 class="mb-1 text-2xl font-bold text-gray-900">Plan your visit</h2>
  <p class="mb-5 text-gray-600">Practical guides to help you buy, budget and get to Kep Crab Market.</p>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {links.map((l) => (
      <a
        href={l.href}
        class="block rounded-xl border border-gray-200 bg-white p-4 transition hover:border-emerald-500 hover:shadow-sm"
      >
        <h3 class="mb-1 font-semibold text-emerald-800">{l.title}</h3>
        <p class="text-sm text-gray-600">{l.desc}</p>
      </a>
    ))}
  </div>
</section>
