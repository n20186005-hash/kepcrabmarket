---
import { getLangFromUrl, localisedUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const lines = {
  zh: ['© 2026 白马螃蟹市场 · 版權所有', '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联'],
  en: ['© 2026 Kep Crab Market · All rights reserved', 'This website is an independent travel information project. We are not affiliated with any government agency or official organisation.'],
  km: ['© 2026 ផ្សារក្តាមកែប · រក្សាសិទ្ធិគ្រប់យ៉ាង', 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។'],
};
const [copyright, disclaimer] = lines[lang as keyof typeof lines];
const links = {
  zh: ['隐私政策', '服务条款', 'Cookie 设置'],
  en: ['Privacy Policy', 'Terms of Service', 'Cookie Settings'],
  km: ['គោលការណ៍ឯកជនភាព', 'លក្ខខណ្ឌសេវាកម្ម', 'ការកំណត់ Cookie'],
}[lang as 'zh' | 'en' | 'km'];
const paths = ['privacy-policy', 'terms-of-service', 'cookie-settings'];
---
<footer class="mt-8 bg-sky-950 text-sky-50">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 py-7 text-sm leading-relaxed text-sky-100/85 md:flex-row md:items-start md:justify-between">
    <div>
      <p>{copyright}</p>
      <p class="mt-2">{disclaimer}</p>
    </div>
    <nav aria-label="Legal" class="flex shrink-0 flex-wrap gap-x-5 gap-y-2 md:justify-end md:text-right">
      {paths.map((path, index) => <a class="underline-offset-4 transition hover:text-white hover:underline" href={localisedUrl(lang, path)}>{links[index]}</a>)}
    </nav>
  </div>
</footer>
