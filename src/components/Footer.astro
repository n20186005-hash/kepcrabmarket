---
import { getLangFromUrl } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const lines = {
  zh: ['© 2026 白马螃蟹市场 · 版權所有', '本网站是一个独立的旅游信息项目。我们与任何政府机构或官方组织均无关联'],
  en: ['© 2026 Kep Crab Market · All rights reserved', 'This website is an independent travel information project. We are not affiliated with any government agency or official organisation.'],
  km: ['© 2026 ផ្សារក្តាមកែប · រក្សាសិទ្ធិគ្រប់យ៉ាង', 'គេហទំព័រនេះជាគម្រោងព័ត៌មានទេសចរណ៍ឯករាជ្យ។ យើងមិនមានទំនាក់ទំនងជាមួយស្ថាប័នរដ្ឋាភិបាល ឬអង្គការផ្លូវការណាមួយឡើយ។'],
};
const [copyright, disclaimer] = lines[lang as keyof typeof lines];
---
<footer class="mt-8 bg-sky-950 text-sky-50">
  <div class="mx-auto max-w-6xl px-4 py-7 text-sm leading-relaxed text-sky-100/85">
    <p>{copyright}</p>
    <p class="mt-2">{disclaimer}</p>
  </div>
</footer>
