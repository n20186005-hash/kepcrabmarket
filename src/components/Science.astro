---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const s = messages.science;
---
<section id="science" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{s.title}</h2>
  <p class="mt-2 max-w-3xl text-gray-600">{s.intro}</p>

  <!-- Ecology ------------------------------------------------------------- -->
  <h3 class="mt-10 text-2xl font-bold text-gray-900">{s.ecologyTitle}</h3>
  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    {
      s.items.map((item: any) => (
        <article class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="text-3xl" aria-hidden="true">
              {item.icon}
            </span>
            <h4 class="text-lg font-semibold text-gray-900">{item.title}</h4>
          </div>
          <div class="mt-3 space-y-3">
            {item.body.map((paragraph: string) => (
              <p class="text-sm leading-relaxed text-gray-600">{paragraph}</p>
            ))}
          </div>
        </article>
      ))
    }
  </div>

  <!-- Responsibility ------------------------------------------------------ -->
  <div class="mt-12 rounded-3xl border border-emerald-100 bg-emerald-50/60 p-6 sm:p-8">
    <h3 class="text-2xl font-bold text-gray-900">{s.dutyTitle}</h3>
    <p class="mt-2 max-w-3xl text-gray-700">{s.dutyIntro}</p>

    <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {
        s.duties.map((duty: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
            <div class="text-2xl" aria-hidden="true">
              {duty.icon}
            </div>
            <h4 class="mt-3 text-sm font-bold text-gray-900">{duty.title}</h4>
            <p class="mt-2 text-xs leading-relaxed text-gray-600">{duty.desc}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-6 rounded-2xl bg-white/70 px-4 py-3 text-xs leading-relaxed text-gray-600">{s.note}</p>
  </div>
</section>
