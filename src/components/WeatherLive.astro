---
/**
 * Live conditions and actionable advice. Rendered on demand by the edge runtime
 * (server island) so the page itself stays fully prerendered and cached, while
 * the readings are refreshed independently.
 *
 * Design rules followed here:
 *   - nothing is shown that does not apply today (no "if it rains" hedging)
 *   - readings stay in one compact panel; the paragraphs talk about decisions
 *   - risk notices come first and only exist when something is actually up
 */
import { getMessagesByLang } from '../i18n/ui';
import { getWeather, iconOf, conditionOf, compassOf, localClock, nextHours } from '../lib/weather';
import { buildAdvice, type Advice, type Tone } from '../lib/advice';

interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const { messages } = getMessagesByLang(locale);
const w = messages.weather;
const l = w.live;
const table = w.smart as Record<string, string>;

const data = await getWeather();

/** Resolve an advice key and interpolate its `{placeholder}` values. */
function t(id: string, params?: Record<string, string | number>): string {
  let out = table[id] ?? id;
  if (params) {
    for (const [key, value] of Object.entries(params)) out = out.split(`{${key}}`).join(String(value));
  }
  return out;
}

const toneBox: Record<Tone, string> = {
  good: 'border-emerald-200 bg-emerald-50 text-emerald-900',
  ok: 'border-black/5 bg-white text-gray-700',
  caution: 'border-amber-200 bg-amber-50 text-amber-900',
  alert: 'border-rose-200 bg-rose-50 text-rose-900',
};

const toneDot: Record<Tone, string> = {
  good: 'bg-emerald-500',
  ok: 'bg-sky-500',
  caution: 'bg-amber-500',
  alert: 'bg-rose-500',
};

const toneBar: Record<Tone, string> = {
  good: 'bg-emerald-500',
  ok: 'bg-sky-600',
  caution: 'bg-amber-500',
  alert: 'bg-rose-500',
};

function dayNumber(date: string): string {
  const [, month, day] = date.split('-');
  return `${Number(day)}/${Number(month)}`;
}

const advice = data ? buildAdvice(data) : null;
const hours = data ? nextHours(data.hours, 24) : [];

function barHeight(prob: number): string {
  return `${Math.max(4, Math.min(100, Math.round(prob)))}%`;
}

function barTone(prob: number): string {
  if (prob >= 60) return 'bg-sky-600';
  if (prob >= 30) return 'bg-sky-400';
  return 'bg-sky-200';
}
---

{
  data && advice ? (
    <div class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{l.title}</h3>
          <p class="mt-1 text-xs text-gray-500">{l.updated.replace('{time}', localClock(data.updatedAt))}</p>
        </div>
        <div class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800">{messages.hero.title}</div>
      </div>

      {/* Readings ---------------------------------------------------------- */}
      <div class="mt-6 flex flex-wrap items-center gap-x-8 gap-y-5">
        <div class="flex items-center gap-4">
          <span class="text-5xl leading-none" aria-hidden="true">{iconOf(data.now.code, data.now.isDay)}</span>
          <div>
            <div class="text-5xl font-extrabold leading-none text-sky-900">{data.now.temperature.toFixed(0)}°</div>
            <div class="mt-1 text-sm font-medium text-gray-600">{w.conditions[conditionOf(data.now.code)]}</div>
            <div class="text-xs text-gray-500">
              {data.today.tMax.toFixed(0)}° / {data.today.tMin.toFixed(0)}°
            </div>
          </div>
        </div>

        <dl class="grid flex-1 grid-cols-2 gap-x-6 gap-y-3 text-sm sm:grid-cols-4">
          <div>
            <dt class="text-xs text-gray-500">{l.feelsLike}</dt>
            <dd class="font-semibold text-gray-900">{data.now.apparent.toFixed(0)}°C</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">{l.rainChance}</dt>
            <dd class="font-semibold text-gray-900">{data.today.precipProb.toFixed(0)}%</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">{l.wind}</dt>
            <dd class="font-semibold text-gray-900">
              {data.now.windSpeed.toFixed(0)} km/h {w.compass[compassOf(data.now.windDirection)]}
            </dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">{l.uv}</dt>
            <dd class="font-semibold text-gray-900">{data.today.uvMax.toFixed(1)}</dd>
          </div>
          {data.sea && (
            <>
              <div>
                <dt class="text-xs text-gray-500">{l.wave}</dt>
                <dd class="font-semibold text-gray-900">{data.sea.waveMax.toFixed(1)} m</dd>
              </div>
              <div>
                <dt class="text-xs text-gray-500">{l.water}</dt>
                <dd class="font-semibold text-gray-900">
                  {data.sea.seaTemp !== null ? `${data.sea.seaTemp.toFixed(0)}°C` : '—'}
                </dd>
              </div>
            </>
          )}
          <div>
            <dt class="text-xs text-gray-500">{l.sunrise}</dt>
            <dd class="font-semibold text-gray-900">{data.today.sunrise}</dd>
          </div>
          <div>
            <dt class="text-xs text-gray-500">{l.sunset}</dt>
            <dd class="font-semibold text-gray-900">{data.today.sunset}</dd>
          </div>
        </dl>
      </div>

      {/* Headline --------------------------------------------------------- */}
      <p class={`mt-6 rounded-2xl border px-4 py-3 text-sm font-semibold leading-relaxed ${toneBox[advice.headlineTone]}`}>
        {t(advice.headlineId)}
      </p>

      {/* Risk notices ----------------------------------------------------- */}
      <div class="mt-4">
        <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{l.noticeTitle}</h4>
        {advice.alerts.length > 0 ? (
          <ul class="mt-2 space-y-2">
            {advice.alerts.map((item: Advice) => (
              <li class={`flex gap-3 rounded-2xl border px-4 py-3 text-sm leading-relaxed ${toneBox[item.tone]}`}>
                <span aria-hidden="true">⚠️</span>
                <span>{t(item.id, item.params)}</span>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-2 flex gap-3 rounded-2xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm leading-relaxed text-emerald-900">
            <span aria-hidden="true">✅</span>
            <span>{t('alerts.calm')}</span>
          </p>
        )}
      </div>

      {/* Three action groups ---------------------------------------------- */}
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {[
          { icon: '✅', title: l.groupOutfit, items: advice.outfit },
          { icon: '🗺️', title: l.groupPlan, items: advice.plan },
          { icon: '🎒', title: l.groupBring, items: advice.bring },
        ].map((group) => (
          <div class="rounded-2xl border border-black/5 bg-gray-50/70 p-5">
            <h4 class="flex items-center gap-2 text-sm font-bold text-gray-900">
              <span aria-hidden="true">{group.icon}</span>
              {group.title}
            </h4>
            <ul class="mt-3 space-y-2.5">
              {group.items.map((item: Advice) => (
                <li class="flex gap-2.5 text-sm leading-relaxed text-gray-700">
                  <span class={`mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full ${toneDot[item.tone]}`} />
                  <span>{t(item.id, item.params)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {/* Scenario guidance ------------------------------------------------- */}
      <div class="mt-6 grid gap-4 lg:grid-cols-3">
        {advice.scenes.map((scene) => (
          <div class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
            <h4 class="flex items-center gap-2 text-sm font-bold text-gray-900">
              <span class="text-lg" aria-hidden="true">{scene.icon}</span>
              {t(scene.titleId)}
            </h4>
            <ul class="mt-3 space-y-2">
              {scene.lines.map((line: Advice) => (
                <li class={`rounded-xl border px-3 py-2 text-xs leading-relaxed ${toneBox[line.tone]}`}>
                  {t(line.id, line.params)}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>

      {/* Hourly rain chance ------------------------------------------------ */}
      {hours.length > 0 && (
        <div class="mt-8">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{l.hourlyTitle}</h4>
            {advice.window && (
              <span class="rounded-full bg-emerald-50 px-3 py-1 text-xs font-semibold text-emerald-800">
                {l.bestWindow}: {String(advice.window.from).padStart(2, '0')}:00–{String(advice.window.to).padStart(2, '0')}:00
              </span>
            )}
          </div>

          <div class="mt-3 flex items-end gap-[3px]" role="img" aria-label={l.hourlyTitle}>
            {hours.map((hour) => (
              <div class="flex h-20 flex-1 flex-col items-center justify-end">
                <div
                  class={`w-full rounded-t-sm ${barTone(hour.precipProb)} ${
                    advice.window && hour.hour >= advice.window.from && hour.hour < advice.window.to ? 'ring-1 ring-emerald-400' : ''
                  }`}
                  style={`height:${barHeight(hour.precipProb)}`}
                />
              </div>
            ))}
          </div>
          <div class="mt-1 flex gap-[3px]">
            {hours.map((hour) => (
              <span class="flex-1 text-center text-[9px] tabular-nums text-gray-400">
                {hour.hour % 3 === 0 ? String(hour.hour).padStart(2, '0') : ''}
              </span>
            ))}
          </div>
          <p class="mt-2 text-[11px] text-gray-500">{l.hourlyCaption}</p>
        </div>
      )}

      {/* Seven-day outlook ------------------------------------------------- */}
      <h4 class="mt-8 text-sm font-semibold uppercase tracking-wide text-gray-500">{l.forecastTitle}</h4>
      <ul class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4 lg:grid-cols-7">
        {data.days.map((day, i) => (
          <li class={`rounded-2xl border px-3 py-3 text-center ${i === 0 ? 'border-sky-200 bg-sky-50/70' : 'border-black/5 bg-white'}`}>
            <div class="text-xs font-semibold text-gray-700">{i === 0 ? l.today : w.weekdays[day.weekday]}</div>
            <div class="text-[11px] text-gray-400">{dayNumber(day.date)}</div>
            <div class="mt-1 text-2xl leading-none" aria-hidden="true">{iconOf(day.code)}</div>
            <div class="mt-1 text-sm font-semibold text-gray-900">
              {day.tMax.toFixed(0)}°<span class="font-normal text-gray-500">/{day.tMin.toFixed(0)}°</span>
            </div>
            <div class="mt-1 text-[11px] text-sky-700">💧 {day.precipProb.toFixed(0)}%</div>
            <span class="sr-only">{w.conditions[conditionOf(day.code)]}</span>
          </li>
        ))}
      </ul>
    </div>
  ) : (
    <div class="rounded-3xl border border-dashed border-gray-300 bg-white p-6 text-sm text-gray-600 sm:p-8">
      {l.unavailable}
    </div>
  )
}
