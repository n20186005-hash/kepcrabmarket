---
import { getI18n } from '../i18n/ui';
import { attraction, siteConfig } from '../config/site';
const { messages } = getI18n(Astro.url);
const a = messages.about;
// Entity semantic binding: the opening statement ties the domain meaning to the
// official Google Maps entity name and its geographic hierarchy.
const lead = String(a.lead).replace('{domain}', siteConfig.domain);
const geo: string[] = a.geo ?? [];
const geoHrefs: (string | null)[] = geo.map((_, i) =>
  i === geo.length - 1 ? attraction.tourismPortal : null,
);
---
<section id="about" class="mx-auto max-w-6xl px-4 py-14">
  <div class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-10">
    <h2 class="text-3xl font-bold text-gray-900">{a.title}</h2>

    <nav
      aria-label={a.title}
      class="mt-4 flex flex-wrap items-center gap-x-2 gap-y-1 text-xs font-medium text-sky-800"
    >
      {
        geo.map((step: string, i: number) => (
          <>
            {i > 0 && (
              <span class="text-gray-400" aria-hidden="true">
                →
              </span>
            )}
            {geoHrefs[i] ? (
              <a
                href={geoHrefs[i] as string}
                target="_blank"
                rel="noopener noreferrer"
                class="transition hover:text-sky-600 hover:underline"
              >
                {step}
              </a>
            ) : (
              <span>{step}</span>
            )}
          </>
        ))
      }
    </nav>

    <p class="mt-6 text-lg font-medium leading-relaxed text-gray-900">{lead}</p>

    <div class="mt-4 space-y-4 text-gray-700 leading-relaxed">
      {a.body.map((p: string) => <p>{p}</p>)}
    </div>
  </div>
</section>
