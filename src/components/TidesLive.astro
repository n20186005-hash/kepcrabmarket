---
/**
 * Live tide panel. Rendered on demand by the edge runtime (server island) so the
 * page itself stays fully prerendered and cached while the predictions refresh
 * independently, exactly like the weather island next door.
 *
 * Rules followed here:
 *   - the chart and the table carry the prediction; the sentences carry the
 *     decision, so no line repeats a number that is already on screen
 *   - every extreme shown is still ahead of the visitor
 *   - darkness is drawn on the curve, because a low water at 22:00 is true but
 *     useless and the chart should say so at a glance
 */
import { getMessagesByLang } from '../i18n/ui';
import { getWeather, localClock } from '../lib/weather';
import { buildTideAdvice, type Advice, type Tone } from '../lib/advice';
import { nextOf, range24h, upcoming, type TideExtreme, type TideKind } from '../lib/tide';

interface Props {
  locale?: string;
}

const { locale } = Astro.props;
const { messages } = getMessagesByLang(locale);
const l = messages.tides.live;
const table = messages.weather.smart as Record<string, string>;

const data = await getWeather();
const tide = data?.tide ?? null;

/** Resolve an advice key and interpolate its `{placeholder}` values. */
function t(id: string, params?: Record<string, string | number>): string {
  let out = table[id] ?? id;
  if (params) {
    for (const [key, value] of Object.entries(params)) out = out.split(`{${key}}`).join(String(value));
  }
  return out;
}

const toneBox: Record<Tone, string> = {
  good: 'border-emerald-200 bg-emerald-50 text-emerald-900',
  ok: 'border-black/5 bg-white text-gray-700',
  caution: 'border-amber-200 bg-amber-50 text-amber-900',
  alert: 'border-rose-200 bg-rose-50 text-rose-900',
};

const toneDot: Record<Tone, string> = {
  good: 'bg-emerald-500',
  ok: 'bg-sky-500',
  caution: 'bg-amber-500',
  alert: 'bg-rose-500',
};

const PAD = { left: 44, right: 12, top: 14, bottom: 26 };
const CHART_W = 720;
const CHART_H = 240;

const advice = tide && data ? buildTideAdvice(tide, data.today.sunrise, data.today.sunset) : [];
const waters = tide ? upcoming(tide) : [];

// Local wall-clock strings ("2026-09-15T06:00") parse identically whatever the
// offset, as long as the same convention is used for the axis and the labels.
const at = (stamp: string): number => Date.parse(`${stamp.length === 16 ? stamp : `${stamp}:00`}:00Z`);

const todayDate = data?.days[0]?.date ?? '';
const tomorrowDate = todayDate
  ? new Date(Date.parse(`${todayDate}T00:00:00Z`) + 86_400_000).toISOString().slice(0, 10)
  : '';

function dayLabel(day: string): string {
  if (day === todayDate) return l.today;
  if (day === tomorrowDate) return l.tomorrow;
  const match = data?.days.find((entry) => entry.date === day);
  if (!match) return day;
  return `${messages.weather.weekdays[match.weekday]} ${Number(day.slice(8))}/${Number(day.slice(5, 7))}`;
}

function relative(hours: number): string {
  if (hours < 1) return l.soon;
  return l.inHours.replace('{hours}', String(hours));
}

/**
 * Chart geometry. The curve starts a few hours before now so the marker sits
 * inside the plot rather than against the left edge, and high/low dots are
 * placed at their interpolated times, not on the hour.
 */
const chart = (() => {
  if (!tide || !data) return null;

  const first = Math.max(
    0,
    tide.series.findIndex((point) => point.time.slice(0, 13) >= tide.now) - 3,
  );
  const points = tide.series.slice(first);
  if (points.length < 2) return null;

  const heights = points.map((point) => point.height);
  const low = Math.min(...heights);
  const high = Math.max(...heights);
  const cushion = Math.max(0.05, (high - low) * 0.15);
  const min = low - cushion;
  const max = high + cushion;

  const plotTop = PAD.top;
  const plotHeight = CHART_H - PAD.top - PAD.bottom;
  const plotWidth = CHART_W - PAD.left - PAD.right;
  const plotBottom = plotTop + plotHeight;

  const from = at(points[0].time);
  const to = at(points[points.length - 1].time);
  const xOf = (stamp: number) => PAD.left + ((stamp - from) / (to - from)) * plotWidth;
  const yOf = (height: number) => plotTop + (1 - (height - min) / (max - min)) * plotHeight;

  const curve = points
    .map((point, i) => `${i === 0 ? 'M' : 'L'}${xOf(at(point.time)).toFixed(1)},${yOf(point.height).toFixed(1)}`)
    .join(' ');

  const area = `${curve} L${xOf(to).toFixed(1)},${plotBottom} L${xOf(from).toFixed(1)},${plotBottom} Z`;

  const gridlines = [max, (max + min) / 2, min].map((value) => ({
    y: yOf(value),
    label: value.toFixed(1),
  }));

  const dots = tide.extremes
    .map((extreme) => ({ ...extreme, stamp: at(`${extreme.day}T${extreme.clock}`) }))
    .filter((extreme) => extreme.stamp >= from && extreme.stamp <= to)
    .map((extreme) => ({
      kind: extreme.kind,
      clock: extreme.clock,
      x: xOf(extreme.stamp),
      y: yOf(extreme.height),
    }));

  // Hours of darkness, taken from the daily sunrise and sunset.
  const bands: { x: number; width: number }[] = [];
  for (const day of data.days) {
    const midnight = at(`${day.date}T00:00`);
    const windows: [number, number][] = [
      [midnight, at(`${day.date}T${day.sunrise}`)],
      [at(`${day.date}T${day.sunset}`), midnight + 86_400_000],
    ];
    for (const [start, end] of windows) {
      const a = Math.max(start, from);
      const b = Math.min(end, to);
      if (b > a) bands.push({ x: xOf(a), width: xOf(b) - xOf(a) });
    }
  }

  const days = data.days
    .map((day) => ({ stamp: at(`${day.date}T12:00`), label: dayLabel(day.date) }))
    .filter((day) => day.stamp >= from && day.stamp <= to)
    .map((day) => ({ x: xOf(day.stamp), label: day.label }));

  return { points, curve, area, gridlines, dots, bands, days, plotTop, plotBottom, nowX: xOf(at(tide.now)) };
})();

const readings: { label: string; water: TideExtreme | null; kind: TideKind }[] = tide
  ? [
      { label: l.nextHigh, water: nextOf(tide, 'high'), kind: 'high' as TideKind },
      { label: l.nextLow, water: nextOf(tide, 'low'), kind: 'low' as TideKind },
    ]
  : [];
---

{
  data && tide && chart && advice ? (
    <div class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-8">
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div>
          <h3 class="text-lg font-bold text-gray-900">{l.title}</h3>
          <p class="mt-1 text-xs text-gray-500">{l.updated.replace('{time}', localClock(data.updatedAt))}</p>
        </div>
        <div class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800">{messages.tides.title}</div>
      </div>

      {/* Readings ---------------------------------------------------------- */}
      <dl class="mt-6 grid grid-cols-2 gap-x-6 gap-y-5 text-sm sm:grid-cols-3 lg:grid-cols-5">
        <div class="col-span-2 sm:col-span-1">
          <dt class="text-xs text-gray-500">{l.level}</dt>
          <dd class="text-3xl font-extrabold leading-none text-sky-900">
            {tide.level.toFixed(2)}<span class="text-base font-semibold"> m</span>
          </dd>
          <dd class={`mt-1 text-xs font-semibold ${tide.rising ? 'text-emerald-700' : 'text-amber-700'}`}>
            <span aria-hidden="true">{tide.rising ? '↗' : '↘'}</span>
            {tide.rising ? l.rising : l.falling}
          </dd>
        </div>
        <div>
          <dt class="text-xs text-gray-500">{l.range}</dt>
          <dd class="font-semibold text-gray-900">{range24h(tide).toFixed(2)} m</dd>
        </div>
        {readings.map((reading) => (
          <div>
            <dt class="text-xs text-gray-500">{reading.label}</dt>
            <dd class="font-semibold tabular-nums text-gray-900">
              <span aria-hidden="true" class="mr-1 text-sky-600">{reading.kind === 'high' ? '▲' : '▼'}</span>
              {reading.water ? reading.water.clock : '—'}
            </dd>
            {reading.water && (
              <dd class="text-xs text-gray-500">
                {reading.water.height.toFixed(2)} m · {relative(reading.water.offsetHours)}
              </dd>
            )}
          </div>
        ))}
      </dl>

      {/* What it means today ----------------------------------------------- */}
      <div class="mt-6">
        <h4 class="text-xs font-semibold uppercase tracking-wide text-gray-500">{l.adviceTitle}</h4>
        <ul class="mt-2 space-y-2">
          {advice.map((item: Advice) => (
            <li class={`flex gap-3 rounded-2xl border px-4 py-3 text-sm leading-relaxed ${toneBox[item.tone]}`}>
              <span class={`mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full ${toneDot[item.tone]}`} />
              <span>{t(item.id, item.params)}</span>
            </li>
          ))}
        </ul>
      </div>

      {/* Curve -------------------------------------------------------------- */}
      <div class="mt-8">
        <h4 class="text-sm font-semibold uppercase tracking-wide text-gray-500">{l.chartTitle}</h4>
        <svg viewBox={`0 0 ${CHART_W} ${CHART_H}`} class="mt-3 h-56 w-full" role="img" aria-label={l.chartTitle}>
          <defs>
            <linearGradient id="tide-fill" x1="0" y1="0" x2="0" y2="1">
              <stop offset="0%" stop-color="#0ea5e9" stop-opacity="0.3" />
              <stop offset="100%" stop-color="#0ea5e9" stop-opacity="0.02" />
            </linearGradient>
          </defs>

          {chart.bands.map((band) => (
            <rect x={band.x} y={chart.plotTop} width={band.width} height={chart.plotBottom - chart.plotTop} fill="#0f172a" opacity="0.05" />
          ))}

          {chart.gridlines.map((line) => (
            <>
              <line x1={PAD.left} x2={CHART_W - PAD.right} y1={line.y} y2={line.y} stroke="#e5e7eb" stroke-width="1" />
              <text x={PAD.left - 8} y={line.y + 3} text-anchor="end" font-size="9" fill="#9ca3af">
                {line.label} m
              </text>
            </>
          ))}

          <path d={chart.area} fill="url(#tide-fill)" />
          <path d={chart.curve} fill="none" stroke="#0284c7" stroke-width="2.5" stroke-linejoin="round" stroke-linecap="round" />

          <line
            x1={chart.nowX}
            x2={chart.nowX}
            y1={chart.plotTop}
            y2={chart.plotBottom}
            stroke="#334155"
            stroke-width="1.5"
            stroke-dasharray="3 3"
          />
          <text x={chart.nowX + 4} y={chart.plotTop + 9} font-size="9" font-weight="600" fill="#334155">
            {l.now}
          </text>

          {chart.dots.map((dot) => (
            <>
              <circle cx={dot.x} cy={dot.y} r="3.5" fill={dot.kind === 'high' ? '#0284c7' : '#f59e0b'} />
              <text
                x={dot.x}
                y={dot.kind === 'high' ? dot.y - 9 : dot.y + 16}
                text-anchor="middle"
                font-size="9"
                font-weight="600"
                fill="#374151"
              >
                {dot.clock}
              </text>
            </>
          ))}

          {chart.days.map((day) => (
            <text x={day.x} y={CHART_H - 8} text-anchor="middle" font-size="10" fill="#6b7280">
              {day.label}
            </text>
          ))}
        </svg>
        <p class="mt-2 text-[11px] text-gray-500">{l.chartCaption}</p>
      </div>

      {/* Table -------------------------------------------------------------- */}
      {waters.length > 0 && (
        <div class="mt-8 overflow-x-auto">
          <table class="w-full border-collapse text-left text-sm">
            <caption class="sr-only">{l.tableTitle}</caption>
            <thead>
              <tr class="border-b border-gray-200 text-xs uppercase tracking-wide text-gray-500">
                <th scope="col" class="py-2 pr-4 font-semibold">{l.columns.day}</th>
                <th scope="col" class="py-2 pr-4 font-semibold">{l.columns.time}</th>
                <th scope="col" class="py-2 font-semibold">{l.columns.height}</th>
              </tr>
            </thead>
            <tbody>
              {waters.map((water) => (
                <tr class="border-b border-gray-100 last:border-0">
                  <th scope="row" class="py-2 pr-4 font-semibold text-gray-900">{dayLabel(water.day)}</th>
                  <td class="py-2 pr-4 tabular-nums text-gray-700">
                    <span aria-hidden="true" class={water.kind === 'high' ? 'text-sky-600' : 'text-amber-600'}>
                      {water.kind === 'high' ? '▲' : '▼'}
                    </span>
                    {' '}
                    {water.clock}
                    <span class="ml-2 text-xs text-gray-500">{water.kind === 'high' ? l.high : l.low}</span>
                  </td>
                  <td class="py-2 tabular-nums font-semibold text-gray-900">{water.height.toFixed(2)} m</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      )}
    </div>
  ) : (
    <div class="rounded-3xl border border-dashed border-gray-300 bg-white p-6 text-sm text-gray-600 sm:p-8">
      {l.unavailable}
    </div>
  )
}
