---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const f = messages.facilities;
---
<section id="facilities" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{f.title}</h2>
  <p class="mt-2 max-w-3xl text-gray-600">{f.intro}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
    {
      f.items.map((item: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <div class="flex items-center gap-3">
            <span class="text-2xl" aria-hidden="true">
              {item.icon}
            </span>
            <h3 class="text-base font-semibold text-gray-900">{item.title}</h3>
          </div>
          <p class="mt-3 text-sm leading-relaxed text-gray-600">{item.desc}</p>
        </div>
      ))
    }
  </div>

  {f.note && <p class="mt-6 rounded-2xl bg-gray-50 px-4 py-3 text-xs leading-relaxed text-gray-600">{f.note}</p>}
</section>
