---
import { langOrder, languages } from '../i18n/ui';

interface Props {
  lang: string;
  class?: string;
}

const { lang, class: className = '' } = Astro.props;

const langHrefs: Record<string, string> = {
  km: '/',
  en: '/en/',
  zh: '/zh/',
};
---
<div class:list={['flex items-center rounded-lg bg-sky-50 p-1 text-sm font-medium', className]}>
  {
    langOrder.map((l) => (
      <a
        href={langHrefs[l]}
        class:list={[
          'rounded-md px-2 py-1 transition',
          l === lang ? 'bg-sky-700 text-white' : 'text-gray-600 hover:text-sky-700',
        ]}
        hreflang={l}
        aria-current={l === lang ? 'true' : undefined}
      >
        {languages[l]}
      </a>
    ))
  }
</div>
