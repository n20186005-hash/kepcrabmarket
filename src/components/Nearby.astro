---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const n = messages.nearby;
---
<section id="nearby" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{n.title}</h2>
  <p class="mt-2 max-w-2xl text-gray-600">{n.intro}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      n.items.map((it: any) => (
        <div class="flex flex-col rounded-2xl border border-black/5 bg-white p-5 shadow-sm transition hover:shadow-md">
          <div class="text-2xl">{it.icon}</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">{it.title}</h3>
          <p class="mt-2 flex-1 text-sm text-gray-600 leading-relaxed">{it.desc}</p>
          <div class="mt-3 inline-block w-fit rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700">{it.distance}</div>
        </div>
      ))
    }
  </div>
</section>
