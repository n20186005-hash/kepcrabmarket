---
import { getI18n } from '../i18n/ui';
import { nearbyGuides, guideUrl, type NearbySlug, type NearbyLang } from '../data/nearbyGuides';
import { extraKepGuides, extraKepUrl, type ExtraKepSlug } from '../data/extraKepGuides';
const { messages, lang } = getI18n(Astro.url);
const n = messages.nearby;
const moreTitle = { en: 'Explore Kep in detail', zh: '深入探索凯普周边', km: 'ស្វែងយល់បន្ថែមអំពីកែប' }[lang];
---
<section id="nearby" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{n.title}</h2>
  <p class="mt-2 max-w-2xl text-gray-600">{n.intro}</p>
  {
    n.cluster && (
      <p class="mt-4 max-w-3xl text-gray-700 leading-relaxed">{n.cluster}</p>
    )
  }

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      n.items.map((it: any) => (
        <div class="flex flex-col rounded-2xl border border-black/5 bg-white p-5 shadow-sm transition hover:shadow-md">
          <div class="text-2xl">{it.icon}</div>
          <h3 class="mt-3 text-lg font-semibold text-gray-900">{it.title}</h3>
          <p class="mt-2 flex-1 text-sm text-gray-600 leading-relaxed">{it.desc}</p>
          <div class="mt-3 inline-block w-fit rounded-full bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700">{it.distance}</div>
        </div>
      ))
    }
  </div>
  <h3 class="mt-9 text-xl font-bold text-gray-900">{moreTitle}</h3>
  <div class="mt-4 grid gap-4 sm:grid-cols-3">
    {Object.entries(nearbyGuides).map(([slug, guide]) => (
      <a href={guideUrl(lang as NearbyLang, slug as NearbySlug)} class="rounded-xl border border-sky-100 bg-sky-50 p-5 transition hover:border-sky-500 hover:shadow-sm">
        <span class="font-semibold text-sky-900">{guide.name[lang as NearbyLang]}</span>
        <p class="mt-2 text-sm leading-relaxed text-gray-600">{guide.subtitle[lang as NearbyLang]}</p>
        <span class="mt-3 inline-block text-sm font-semibold text-sky-700">→</span>
      </a>
    ))}
    {Object.entries(extraKepGuides).map(([slug, guide]) => (
      <a href={extraKepUrl(lang as NearbyLang, slug as ExtraKepSlug)} class="overflow-hidden rounded-xl border border-sky-100 bg-sky-50 transition hover:border-sky-500 hover:shadow-sm">
        <img src={guide.image} alt={guide[lang as NearbyLang].name} loading="lazy" width="600" height="400" class="h-40 w-full object-cover" />
        <div class="p-5"><span class="font-semibold text-sky-900">{guide[lang as NearbyLang].name}</span><p class="mt-2 text-sm leading-relaxed text-gray-600">{guide[lang as NearbyLang].subtitle}</p><span class="mt-3 inline-block text-sm font-semibold text-sky-700">→</span></div>
      </a>
    ))}
  </div>
</section>
