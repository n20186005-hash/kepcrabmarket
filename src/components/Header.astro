---
import { getLangFromUrl, getI18n } from '../i18n/ui';
import LanguageSwitcher from './LanguageSwitcher.astro';

const lang = getLangFromUrl(Astro.url);
const { messages } = getI18n(Astro.url);

/** Always-visible links: the sections people arrive looking for. */
const primaryNav = [
  { key: 'overview', href: '#overview' },
  { key: 'about', href: '#about' },
  { key: 'history', href: '#history' },
  { key: 'culture', href: '#culture' },
  { key: 'highlights', href: '#highlights' },
  { key: 'weather', href: '#weather' },
  { key: 'facilities', href: '#facilities' },
];

/** Everything else, kept one click away so the bar never wraps. */
const moreNav = [
  { key: 'tides', href: '#tides' },
  { key: 'nearby', href: '#nearby' },
  { key: 'besttime', href: '#besttime' },
  { key: 'guide', href: '#guide' },
  { key: 'transport', href: '#transport' },
  { key: 'science', href: '#science' },
  { key: 'location', href: '#location' },
  { key: 'faq', href: '#faq' },
];

const allNav = [...primaryNav, ...moreNav];

const langHrefs: Record<string, string> = {
  km: '/',
  en: '/en/',
  zh: '/zh/',
};

const siteName = messages.header.siteName;
---
<header class="fixed inset-x-0 top-0 z-50 border-b border-black/5 bg-white/85 backdrop-blur">
  <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3">
    <a href={langHrefs[lang]} class="flex items-center gap-2 font-bold text-sky-700">
      <span class="grid h-8 w-8 place-items-center rounded-lg bg-sky-700 text-white">🦀</span>
      <span class="text-sm leading-tight sm:text-base">{siteName}</span>
    </a>

    <nav class="hidden items-center gap-0.5 md:flex" aria-label="Primary">
      {
        primaryNav.map((item) => (
          <a
            href={item.href}
            class="whitespace-nowrap rounded-md px-2.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-sky-50 hover:text-sky-700"
          >
            {messages.nav[item.key]}
          </a>
        ))
      }

      <div class="group relative">
        <button
          type="button"
          class="flex items-center gap-1 whitespace-nowrap rounded-md px-2.5 py-2 text-sm font-medium text-gray-700 transition hover:bg-sky-50 hover:text-sky-700"
          aria-haspopup="true"
        >
          {messages.nav.more}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            class="h-4 w-4"
          >
            <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
          </svg>
        </button>

        <div
          class="invisible absolute right-0 top-full z-50 w-56 translate-y-1 rounded-2xl border border-black/5 bg-white p-1.5 opacity-0 shadow-lg transition duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100"
        >
          {
            moreNav.map((item) => (
              <a
                href={item.href}
                class="block rounded-xl px-3 py-2 text-sm font-medium text-gray-700 transition hover:bg-sky-50 hover:text-sky-700"
              >
                {messages.nav[item.key]}
              </a>
            ))
          }
        </div>
      </div>
    </nav>

    <div class="flex items-center gap-1">
      <LanguageSwitcher lang={lang} />

      <button
        id="menu-toggle"
        class="ml-1 grid h-9 w-9 place-items-center rounded-lg text-gray-700 hover:bg-sky-50 md:hidden"
        aria-label="Menu"
        aria-expanded="false"
      >
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="h-5 w-5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-menu" class="hidden border-t border-black/5 bg-white md:hidden" aria-label="Mobile">
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-1 px-4 py-2">
      {
        allNav.map((item) => (
          <a
            href={item.href}
            class="rounded-md px-3 py-2 text-sm font-medium text-gray-700 hover:bg-sky-50 hover:text-sky-700"
          >
            {messages.nav[item.key]}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script is:inline>
  (function () {
    var btn = document.getElementById('menu-toggle');
    var menu = document.getElementById('mobile-menu');
    if (!btn || !menu) return;
    btn.addEventListener('click', function () {
      var open = menu.classList.toggle('hidden') === false;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
    menu.querySelectorAll('a').forEach(function (a) {
      a.addEventListener('click', function () {
        menu.classList.add('hidden');
        btn.setAttribute('aria-expanded', 'false');
      });
    });
  })();
</script>
