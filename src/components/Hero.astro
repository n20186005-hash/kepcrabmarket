---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const hero = messages.hero;
---
<section id="overview" class="relative overflow-hidden bg-ocean text-white">
  <div class="pointer-events-none absolute -top-24 left-1/2 h-72 w-72 -translate-x-1/2 rounded-full bg-sky-400/30 blur-3xl"></div>
  <div class="pointer-events-none absolute bottom-0 right-0 h-64 w-64 rounded-full bg-amber-400/20 blur-3xl"></div>

  <div class="relative mx-auto flex max-w-6xl flex-col items-center px-4 pb-20 pt-28 text-center sm:pt-32">
    <p class="mb-4 inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/10 px-4 py-1.5 text-xs font-medium tracking-wide text-sky-100 backdrop-blur">
      🦀 {hero.eyebrow}
    </p>
    <h1 class="text-balance text-4xl font-extrabold leading-tight sm:text-6xl">
      {hero.title}
    </h1>
    <p class="mt-3 text-sm font-medium tracking-wide text-sky-100/90 sm:text-base">
      {hero.enName} · {hero.zhName}
    </p>
    <p class="mt-6 max-w-2xl text-balance text-base text-white/80 sm:text-lg">
      {hero.subtitle}
    </p>
    <div class="mt-9 flex flex-col gap-3 sm:flex-row">
      <a
        href="#location"
        class="inline-flex items-center justify-center gap-2 rounded-full bg-amber-500 px-6 py-3 text-sm font-semibold text-sky-950 shadow-lg shadow-amber-500/20 transition hover:bg-amber-400"
      >
        📍 {hero.ctaMap}
      </a>
      <a
        href="#about"
        class="inline-flex items-center justify-center gap-2 rounded-full border border-white/30 bg-white/10 px-6 py-3 text-sm font-semibold text-white backdrop-blur transition hover:bg-white/20"
      >
        🦀 {hero.ctaExplore}
      </a>
    </div>
  </div>

  <div class="relative h-10 w-full overflow-hidden text-slate-50">
    <svg viewBox="0 0 1440 60" preserveAspectRatio="none" class="absolute bottom-0 h-full w-full">
      <path fill="currentColor" d="M0,32 C240,72 480,8 720,28 C960,48 1200,80 1440,40 L1440,60 L0,60 Z"></path>
    </svg>
  </div>
</section>
