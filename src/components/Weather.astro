---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const w = messages.weather;
---
<section id="weather" class="bg-sky-50/60">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-3xl font-bold text-gray-900">{w.title}</h2>
    <p class="mt-2 max-w-2xl text-gray-600">{w.intro}</p>

    <div class="mt-8 grid gap-5 sm:grid-cols-3">
      {
        w.items.map((item: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="text-3xl">{item.icon}</div>
            <h3 class="mt-4 text-lg font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.desc}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
