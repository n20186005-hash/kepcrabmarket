---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const t = messages.transport;
---
<section id="transport" class="bg-sky-50/60">
  <div class="mx-auto max-w-6xl px-4 py-14">
    <h2 class="text-3xl font-bold text-gray-900">{t.title}</h2>
    <p class="mt-2 max-w-2xl text-gray-600">{t.intro}</p>

    <div class="mt-8 grid gap-6 lg:grid-cols-2">
      {
        t.routes.map((route: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="text-2xl">{route.icon}</span>
              <h3 class="text-lg font-semibold text-gray-900">{route.title}</h3>
            </div>
            <p class="mt-3 text-sm text-gray-600 leading-relaxed">{route.desc}</p>
            <ol class="mt-4 space-y-2">
              {
                route.steps.map((step: string, i: number) => (
                  <li class="flex gap-3 text-sm text-gray-700">
                    <span class="grid h-6 w-6 shrink-0 place-items-center rounded-full bg-sky-700 text-xs font-semibold text-white">{i + 1}</span>
                    <span>{step}</span>
                  </li>
                ))
              }
            </ol>
          </div>
        ))
      }
    </div>
  </div>
</section>
