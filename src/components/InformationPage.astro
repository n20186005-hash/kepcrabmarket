---
import BaseLayout from '../layouts/BaseLayout.astro';
import Sources from './Sources.astro';
import Reviews from './Reviews.astro';
import { getI18n } from '../i18n/ui';

interface Props { section: 'sources' | 'reviews' | 'image-credits' }
const { section } = Astro.props;
const { lang, messages } = getI18n(Astro.url);
const labels = {
  zh: { 'sources': '资料来源', 'reviews': '游客评价', 'image-credits': '图片来源与版权说明', back: '返回首页' },
  en: { 'sources': 'Sources', 'reviews': 'Visitor reviews', 'image-credits': 'Image credits and copyright', back: 'Back to homepage' },
  km: { 'sources': 'ប្រភពព័ត៌មាន', 'reviews': 'មតិអ្នកទស្សនា', 'image-credits': 'ប្រភពរូបភាព និងសិទ្ធិអ្នកនិពន្ធ', back: 'ត្រឡប់ទៅទំព័រដើម' },
};
const label = labels[lang as keyof typeof labels][section];
const home = lang === 'km' ? '/' : `/${lang}/`;
---
<BaseLayout title={`${label} | ${messages.header.siteName}`} description={section === 'sources' ? messages.sources.intro : section === 'reviews' ? messages.reviews.intro : messages.sources.imageRights}>
  <main class="min-h-[65vh] bg-slate-50 pt-24 pb-10">
    <div class="mx-auto max-w-6xl px-4">
      <a href={home} class="inline-flex rounded-full bg-white px-4 py-2 text-sm font-semibold text-sky-700 shadow-sm hover:text-sky-900">← {labels[lang as keyof typeof labels].back}</a>
    </div>
    {section === 'sources' && <Sources />}
    {section === 'sources' && (
      <section class="mx-auto max-w-6xl px-4 pb-10">
        <div class="rounded-3xl bg-white p-6 text-sm leading-relaxed text-gray-600 shadow-sm sm:p-10">
          <h2 class="mb-3 text-lg font-semibold text-gray-900">{messages.footer.siteName}</h2>
          <p>{messages.footer.tagline}</p>
          <p class="mt-3">{messages.footer.disclaimer}</p>
        </div>
      </section>
    )}
    {section === 'reviews' && <Reviews />}
    {section === 'image-credits' && (
      <section class="mx-auto max-w-6xl px-4 py-14">
        <div class="rounded-3xl border border-black/5 bg-white p-6 shadow-sm sm:p-10">
          <h1 class="text-3xl font-bold text-gray-900">{label}</h1>
          <h2 class="mt-8 text-lg font-semibold text-gray-900">{messages.sources.imagesLabel}</h2>
          <p class="mt-3 leading-relaxed text-gray-600">{messages.sources.imageRights}</p>
          <p class="mt-4 leading-relaxed text-gray-600">{messages.footer.imageRights}</p>
        </div>
      </section>
    )}
  </main>
</BaseLayout>
