---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const h = messages.history;
---
<section id="history" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{h.title}</h2>
  <p class="mt-2 max-w-2xl text-gray-600">{h.intro}</p>

  <div class="relative mt-10 border-l-2 border-sky-200 pl-6">
    {
      h.timeline.map((item: any) => (
        <div class="relative mb-8 last:mb-0">
          <span class="absolute -left-[31px] top-1.5 grid h-5 w-5 place-items-center rounded-full bg-sky-600 text-white ring-4 ring-white"></span>
          <div class="rounded-2xl border border-black/5 bg-white p-5 shadow-sm">
            <div class="text-xs font-semibold uppercase tracking-wide text-sky-700">{item.period}</div>
            <h3 class="mt-1 text-lg font-semibold text-gray-900">{item.title}</h3>
            <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.text}</p>
          </div>
        </div>
      ))
    }
  </div>

  {
    h.sourcesNote && (
      <div class="mt-8 rounded-2xl border border-black/5 bg-gray-50 p-5 text-sm text-gray-600">
        <p>{h.sourcesNote}</p>
        {h.sources && h.sources.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-x-5 gap-y-1">
            {h.sources.map((s: any) => (
              <li>
                <a href={s.url} target="_blank" rel="noopener noreferrer" class="font-medium text-sky-700 hover:underline">↗ {s.label}</a>
              </li>
            ))}
          </ul>
        )}
      </div>
    )
  }
</section>
