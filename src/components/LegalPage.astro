---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n } from '../i18n/ui';

interface Props {
  section: 'privacy' | 'terms' | 'cookie';
}

const { section } = Astro.props;
const { messages } = getI18n(Astro.url);
const data = messages.legal[section];
---
<BaseLayout title={data.title} description={data.title}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-bold text-gray-900">{data.title}</h1>
    <div class="mt-8 space-y-4">
      {
        data.body.map((p: string) => (
          <p class="text-gray-700 leading-relaxed">{p}</p>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-gray-500">
      <a href={section === 'privacy' ? './' : '../'} class="text-sky-700 hover:underline">←</a>
    </p>
  </section>
</BaseLayout>
