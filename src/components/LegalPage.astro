---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n } from '../i18n/ui';

interface Props {
  section: 'privacy' | 'terms' | 'cookie';
}

const { section } = Astro.props;
const { messages } = getI18n(Astro.url);
const data = messages.legal[section];
const backHref = Astro.url.pathname.startsWith('/en/') ? '/en/' : Astro.url.pathname.startsWith('/zh/') ? '/zh/' : '/';
const language = Astro.url.pathname.startsWith('/en/') ? 'en' : Astro.url.pathname.startsWith('/zh/') ? 'zh' : 'km';
const controls = {
  zh: { label: '允许匿名访问统计（Google Analytics）', save: '保存偏好设置', reject: '拒绝分析型 Cookie', saved: '设置已保存。', status: '当前选择：' },
  en: { label: 'Allow anonymous visit analytics (Google Analytics)', save: 'Save preferences', reject: 'Reject analytics cookies', saved: 'Preferences saved.', status: 'Current choice: ' },
  km: { label: 'អនុញ្ញាតឱ្យវិភាគចំនួនអ្នកចូលមើល (Google Analytics)', save: 'រក្សាទុកជម្រើស', reject: 'បដិសេធ Cookie វិភាគ', saved: 'បានរក្សាទុកជម្រើស។', status: 'ជម្រើសបច្ចុប្បន្ន៖ ' },
}[language as 'zh'|'en'|'km'];
---

<BaseLayout title={data.title} description={data.title}>
  <article class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-bold text-gray-900">{data.title}</h1>
    {data.updated && (
      <p class="mt-2 text-sm text-gray-500">{data.updated}</p>
    )}
    {data.intro && (
      <p class="mt-6 text-gray-700 leading-relaxed">{data.intro}</p>
    )}

    <div class="mt-10 space-y-10">
      {
        data.body.map((block: {heading?: string; paragraphs?: string[]; list?: string[]; note?: string}) => (
          <section>
            {block.heading && (
              <h2 class="text-xl font-semibold text-gray-900">{block.heading}</h2>
            )}
            {block.paragraphs && (
              <div class="mt-3 space-y-3">
                {block.paragraphs.map((p: string) => (
                  <p class="text-gray-700 leading-relaxed">{p}</p>
                ))}
              </div>
            )}
            {block.list && (
              <ul class="mt-3 list-disc space-y-2 pl-6 text-gray-700 leading-relaxed">
                {block.list.map((li: string) => (
                  <li>{li}</li>
                ))}
              </ul>
            )}
            {block.note && (
              <p class="mt-3 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900">{block.note}</p>
            )}
          </section>
        ))
      }
    </div>

    {section === 'cookie' && (
      <section class="mt-10 rounded-xl border border-sky-200 bg-sky-50 p-5" aria-label={data.title}>
        <label class="flex cursor-pointer items-start gap-3 font-medium text-sky-950">
          <input id="analytics-consent" type="checkbox" class="mt-1 h-5 w-5 accent-sky-700" />
          <span>{controls.label}</span>
        </label>
        <div class="mt-5 flex flex-wrap gap-3">
          <button id="save-consent" type="button" class="rounded-lg bg-sky-800 px-5 py-2.5 font-semibold text-white hover:bg-sky-900">{controls.save}</button>
          <button id="reject-consent" type="button" class="rounded-lg border border-sky-700 px-5 py-2.5 font-semibold text-sky-900 hover:bg-white">{controls.reject}</button>
        </div>
        <p id="consent-status" role="status" aria-live="polite" class="mt-3 text-sm text-sky-900"></p>
      </section>
    )}

    <p class="mt-12 text-sm text-gray-500">
      <a href={backHref} class="text-sky-700 hover:underline">←</a>
    </p>
  </article>
  {section === 'cookie' && (
    <script is:inline define:vars={{ controls }}>
      const toggle = document.getElementById('analytics-consent');
      const status = document.getElementById('consent-status');
      const key = 'kep-cookie-analytics-consent';
      let current = 'denied';
      try { current = localStorage.getItem(key) || 'denied'; } catch (e) {}
      toggle.checked = current === 'granted';
      const save = (allowed) => {
        toggle.checked = allowed;
        if (typeof window.kepAnalyticsConsent === 'function') window.kepAnalyticsConsent(allowed);
        status.textContent = controls.saved;
      };
      document.getElementById('save-consent').addEventListener('click', () => save(toggle.checked));
      document.getElementById('reject-consent').addEventListener('click', () => save(false));
    </script>
  )}
</BaseLayout>
