---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n } from '../i18n/ui';

interface Props {
  section: 'privacy' | 'terms' | 'cookie';
}

const { section } = Astro.props;
const { messages } = getI18n(Astro.url);
const data = messages.legal[section];
const backHref = section === 'privacy' ? './' : '../';
---

<BaseLayout title={data.title} description={data.title}>
  <article class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-bold text-gray-900">{data.title}</h1>
    {data.updated && (
      <p class="mt-2 text-sm text-gray-500">{data.updated}</p>
    )}
    {data.intro && (
      <p class="mt-6 text-gray-700 leading-relaxed">{data.intro}</p>
    )}

    <div class="mt-10 space-y-10">
      {
        data.body.map((block) => (
          <section>
            {block.heading && (
              <h2 class="text-xl font-semibold text-gray-900">{block.heading}</h2>
            )}
            {block.paragraphs && (
              <div class="mt-3 space-y-3">
                {block.paragraphs.map((p: string) => (
                  <p class="text-gray-700 leading-relaxed">{p}</p>
                ))}
              </div>
            )}
            {block.list && (
              <ul class="mt-3 list-disc space-y-2 pl-6 text-gray-700 leading-relaxed">
                {block.list.map((li: string) => (
                  <li>{li}</li>
                ))}
              </ul>
            )}
            {block.note && (
              <p class="mt-3 rounded-lg bg-sky-50 px-4 py-3 text-sm text-sky-900">{block.note}</p>
            )}
          </section>
        ))
      }
    </div>

    <p class="mt-12 text-sm text-gray-500">
      <a href={backHref} class="text-sky-700 hover:underline">←</a>
    </p>
  </article>
</BaseLayout>
