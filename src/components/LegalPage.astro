---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getI18n } from '../i18n/ui';

interface Props {
  section: 'privacy' | 'terms' | 'cookie';
}

const { section } = Astro.props;
const { messages } = getI18n(Astro.url);
const data = messages[section];
---
<BaseLayout title={data.title} description={data.intro ?? data.title}>
  <section class="mx-auto max-w-3xl px-4 py-20">
    <h1 class="text-3xl font-bold text-gray-900">{data.title}</h1>
    {data.intro && <p class="mt-3 text-gray-600">{data.intro}</p>}
    <div class="mt-8 space-y-6">
      {
        data.sections.map((s: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <h2 class="text-lg font-semibold text-gray-900">{s.h}</h2>
            <p class="mt-2 text-gray-700 leading-relaxed">{s.p}</p>
          </div>
        ))
      }
    </div>
    <p class="mt-8 text-sm text-gray-500">
      <a href={section === 'privacy' ? './' : '../'} class="text-sky-700 hover:underline">←</a>
    </p>
  </section>
</BaseLayout>
