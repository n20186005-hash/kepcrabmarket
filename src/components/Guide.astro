---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const g = messages.guide;
---
<section id="guide" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{g.title}</h2>

  <div class="mt-6 rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-wide text-sky-700">{g.stay}</p>
    <p class="mt-2 text-gray-700">{g.stayDesc}</p>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {
      g.routes.map((route: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">{route.title}</h3>
          <ol class="mt-4 space-y-3">
            {
              route.steps.map((step: string, i: number) => (
                <li class="flex items-center gap-3">
                  <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sky-700 text-sm font-semibold text-white">{i + 1}</span>
                  <span class="text-gray-700">{step}</span>
                </li>
              ))
            }
          </ol>
        </div>
      ))
    }
  </div>
</section>
