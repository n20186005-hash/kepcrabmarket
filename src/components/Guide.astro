---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const g = messages.guide;
const labels = g.audienceLabels;
---
<section id="guide" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{g.title}</h2>

  <div class="mt-6 rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
    <p class="text-sm font-medium uppercase tracking-wide text-sky-700">{g.stay}</p>
    <p class="mt-2 text-gray-700">{g.stayDesc}</p>
  </div>

  <div class="mt-6 grid gap-5 sm:grid-cols-2">
    {
      g.routes.map((route: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
          <h3 class="text-lg font-semibold text-gray-900">{route.title}</h3>
          <ol class="mt-4 space-y-3">
            {route.steps.map((step: string, i: number) => (
              <li class="flex items-center gap-3">
                <span class="grid h-7 w-7 shrink-0 place-items-center rounded-full bg-sky-700 text-sm font-semibold text-white">
                  {i + 1}
                </span>
                <span class="text-gray-700">{step}</span>
              </li>
            ))}
          </ol>
        </div>
      ))
    }
  </div>

  <!-- Recommended half-day / full-day routes ------------------------------- -->
  <div class="mt-12">
    <h3 class="text-2xl font-bold text-gray-900">{g.planTitle}</h3>
    <p class="mt-2 max-w-3xl text-gray-600">{g.planIntro}</p>

    <div class="mt-6 grid gap-5 lg:grid-cols-2">
      {
        g.plans.map((plan: any) => (
          <div class="flex flex-col rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="flex flex-wrap items-baseline justify-between gap-2">
              <h4 class="text-lg font-semibold text-gray-900">{plan.title}</h4>
              <span class="rounded-full bg-sky-50 px-3 py-1 text-xs font-semibold text-sky-800">
                {plan.duration}
              </span>
            </div>
            <p class="mt-3 text-sm text-gray-600">{plan.bestFor}</p>

            <ol class="mt-5 space-y-4 border-l border-dashed border-sky-200 pl-5">
              {plan.timeline.map((step: any) => (
                <li class="relative">
                  <span class="absolute -left-[1.65rem] top-1.5 h-2 w-2 rounded-full bg-sky-600" />
                  <span class="block text-xs font-semibold tracking-wide text-sky-700">{step.time}</span>
                  <span class="mt-1 block text-sm leading-relaxed text-gray-700">{step.text}</span>
                </li>
              ))}
            </ol>

            <p class="mt-5 rounded-2xl bg-amber-50 px-4 py-3 text-xs leading-relaxed text-amber-900">
              💡 {plan.tip}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Audience-specific plans --------------------------------------------- -->
  <div class="mt-12">
    <h3 class="text-2xl font-bold text-gray-900">{g.audienceTitle}</h3>
    <p class="mt-2 max-w-3xl text-gray-600">{g.audienceIntro}</p>

    <div class="mt-6 grid gap-5 lg:grid-cols-3">
      {
        g.audience.map((plan: any) => (
          <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm">
            <div class="flex items-center gap-3">
              <span class="text-3xl" aria-hidden="true">
                {plan.icon}
              </span>
              <h4 class="text-base font-semibold text-gray-900">{plan.title}</h4>
            </div>

            <dl class="mt-4 space-y-2 text-sm">
              <div class="flex gap-2">
                <dt class="shrink-0 font-medium text-gray-500">{labels.when}:</dt>
                <dd class="text-sky-800">{plan.when}</dd>
              </div>
              <div class="flex gap-2">
                <dt class="shrink-0 font-medium text-gray-500">{labels.pace}:</dt>
                <dd class="text-sky-800">{plan.pace}</dd>
              </div>
            </dl>

            <ul class="mt-4 space-y-2 text-sm leading-relaxed text-gray-700">
              {plan.points.map((point: string) => (
                <li class="flex gap-2">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-amber-500" />
                  <span>{point}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
