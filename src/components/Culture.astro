---
import { getI18n } from '../i18n/ui';
const { messages } = getI18n(Astro.url);
const c = messages.culture;
---
<section id="culture" class="mx-auto max-w-6xl px-4 py-14">
  <h2 class="text-3xl font-bold text-gray-900">{c.title}</h2>
  <p class="mt-2 max-w-2xl text-gray-600">{c.intro}</p>

  <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
    {
      c.items.map((item: any) => (
        <div class="rounded-2xl border border-black/5 bg-white p-6 shadow-sm transition hover:shadow-md">
          <div class="text-3xl">{item.icon}</div>
          <h3 class="mt-4 text-lg font-semibold text-gray-900">{item.title}</h3>
          <p class="mt-2 text-sm text-gray-600 leading-relaxed">{item.desc}</p>
        </div>
      ))
    }
  </div>

  <div class="mt-10 rounded-3xl border border-amber-200 bg-amber-50 p-6 sm:p-8">
    <div class="flex items-center gap-3">
      <span class="text-2xl">🦀</span>
      <h3 class="text-xl font-bold text-amber-900">{c.legend.title}</h3>
    </div>
    <div class="mt-4 space-y-3">
      {
        c.legend.body.map((p: string) => (
          <p class="text-sm text-amber-900/80 leading-relaxed">{p}</p>
        ))
      }
    </div>
  </div>
</section>
