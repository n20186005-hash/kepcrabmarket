{
  // Cloudflare Workers deployment target for kepcrabmarket.com
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kepcrabmarket",
  "main": "./dist/_worker.js/index.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  }
}
